<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ClayTech - Mission 01: The Transparent Vault</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@300;400;500;600&display=swap');

      * { box-sizing: border-box; margin: 0; padding: 0; }

      .ct {
        font-family: 'Inter', sans-serif;
        background: #060a12;
        color: #c9d1d9;
        min-height: 100vh;
        overflow-x: hidden;
      }

      .ct-bg {
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(31,111,235,0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(31,111,235,0.04) 1px, transparent 1px);
        background-size: 44px 44px;
        pointer-events: none;
        z-index: 0;
      }
      .ct-glow {
        position: fixed;
        top: -200px; left: -200px;
        width: 600px; height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(31,111,235,0.08) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      .ct-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(6,10,18,0.95);
        border-bottom: 1px solid rgba(31,111,235,0.15);
        padding: 0.9rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .ct-nav-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
      }

      .ct-shield {
        width: 28px;
        height: 32px;
        flex-shrink: 0;
      }

      .ct-brand-text {
        font-family: 'Space Mono', monospace;
        font-size: 13px;
        font-weight: 700;
        color: #58a6ff;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .ct-nav-right {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .ct-nav-badge {
        font-family: 'Space Mono', monospace;
        font-size: 10px;
        color: #58a6ff;
        border: 1px solid rgba(31,111,235,0.35);
        padding: 4px 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .ct-nav-pts {
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        color: #8b949e;
        letter-spacing: 0.08em;
      }
      .ct-nav-pts span { color: #58a6ff; }

      .ct-hero {
        position: relative;
        z-index: 1;
        padding: 3rem 2rem 2rem;
        max-width: 860px;
        margin: 0 auto;
        display: flex;
        align-items: flex-start;
        gap: 2rem;
      }

      .ct-mission-num {
        font-family: 'Space Mono', monospace;
        font-size: 72px;
        font-weight: 700;
        color: rgba(31,111,235,0.08);
        line-height: 1;
        user-select: none;
        flex-shrink: 0;
        margin-top: -8px;
      }

      .ct-mission-tag {
        font-family: 'Space Mono', monospace;
        font-size: 10px;
        color: #58a6ff;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 0.6rem;
      }
      .ct-live-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: #2ea44f;
        animation: blink 2s ease-in-out infinite;
      }
      @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }

      .ct-hero-title {
        font-family: 'Space Mono', monospace;
        font-size: clamp(1.2rem, 3vw, 1.8rem);
        font-weight: 700;
        color: #e6edf3;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.75rem;
        line-height: 1.2;
      }
      .ct-hero-title .ct-blue { color: #58a6ff; }

      .ct-hero-sub {
        font-size: 14px;
        color: #8b949e;
        line-height: 1.7;
        max-width: 520px;
      }

      .ct-difficulty-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
      }

      .ct-badge {
        font-family: 'Space Mono', monospace;
        font-size: 10px;
        padding: 3px 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .ct-badge-green { background: rgba(46,164,79,0.1); color: #2ea44f; border: 1px solid rgba(46,164,79,0.3); }
      .ct-badge-blue  { background: rgba(31,111,235,0.1); color: #58a6ff; border: 1px solid rgba(31,111,235,0.3); }

      .ct-main {
        position: relative;
        z-index: 1;
        max-width: 860px;
        margin: 0 auto;
        padding: 0 2rem 4rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .ct-panel {
        background: #0d1117;
        border: 1px solid #21262d;
        position: relative;
        overflow: hidden;
      }
      .ct-panel::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(31,111,235,0.5), transparent);
      }

      .ct-panel-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #21262d;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .ct-panel-title {
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        color: #8b949e;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .ct-panel-body { padding: 1.25rem; }

      .ct-briefing-item {
        display: flex;
        gap: 10px;
        margin-bottom: 1rem;
        font-size: 13px;
        line-height: 1.6;
      }
      .ct-briefing-item:last-child { margin-bottom: 0; }

      .ct-bi-label {
        font-family: 'Space Mono', monospace;
        font-size: 10px;
        color: #58a6ff;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        white-space: nowrap;
        padding-top: 1px;
        min-width: 72px;
      }

      .ct-bi-val { color: #8b949e; }

      .ct-tip {
        background: rgba(31,111,235,0.05);
        border-left: 2px solid rgba(31,111,235,0.4);
        padding: 0.75rem 1rem;
        font-size: 12px;
        color: #8b949e;
        line-height: 1.6;
        margin-top: 1rem;
      }
      .ct-tip strong { color: #58a6ff; font-weight: 500; }

      .ct-vault-label {
        font-size: 11px;
        color: #8b949e;
        margin-bottom: 6px;
        display: block;
        font-family: 'Space Mono', monospace;
        letter-spacing: 0.08em;
      }

      .ct-vault-input {
        width: 100%;
        background: #060a12;
        border: 1px solid #21262d;
        color: #c9d1d9;
        padding: 0.6rem 0.75rem;
        font-family: 'Space Mono', monospace;
        font-size: 13px;
        outline: none;
        margin-bottom: 1rem;
        transition: border-color 0.2s;
      }
      .ct-vault-input:focus { border-color: rgba(31,111,235,0.4); }
      .ct-vault-input[disabled] { opacity: 0.4; cursor: not-allowed; }
      .ct-vault-input[type="password"] { color: #8b949e; }

      .ct-vault-btn {
        width: 100%;
        background: #21262d;
        color: #8b949e;
        border: 1px solid #30363d;
        padding: 0.7rem;
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        transition: 0.2s;
      }
      .ct-vault-btn:hover { background: #30363d; color: #c9d1d9; }

      .ct-locked-msg {
        margin-top: 0.75rem;
        font-size: 12px;
        color: #f85149;
        font-family: 'Space Mono', monospace;
        text-align: center;
        display: none;
      }

      .ct-full { grid-column: 1 / -1; }

      .ct-flag-wrap {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: start;
      }

      .ct-flag-input-row {
        position: relative;
      }

      .ct-flag-prefix {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-family: 'Space Mono', monospace;
        font-size: 13px;
        color: rgba(88,166,255,0.5);
        pointer-events: none;
        user-select: none;
      }

      #flagInput {
        width: 100%;
        background: #060a12;
        border: 1px solid #21262d;
        color: #58a6ff;
        padding: 0.8rem 1rem 0.8rem 2.25rem;
        font-family: 'Space Mono', monospace;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
        letter-spacing: 0.04em;
      }
      #flagInput::placeholder { color: rgba(88,166,255,0.25); }
      #flagInput:focus { border-color: rgba(31,111,235,0.5); }

      .ct-submit-btn {
        background: #1f6feb;
        color: #fff;
        border: none;
        padding: 0.8rem 1.5rem;
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.2s, transform 0.1s;
      }
      .ct-submit-btn:hover { background: #388bfd; }
      .ct-submit-btn:active { transform: scale(0.98); }

      #result {
        margin-top: 1rem;
        display: none;
        font-family: 'Space Mono', monospace;
        font-size: 13px;
        padding: 1rem 1.25rem;
        line-height: 1.7;
      }

      .ct-success {
        background: rgba(46,164,79,0.06);
        border: 1px solid rgba(46,164,79,0.3);
        color: #2ea44f;
      }
      .ct-error {
        background: rgba(248,81,73,0.06);
        border: 1px solid rgba(248,81,73,0.25);
        color: #f85149;
      }

      .ct-next-link {
        display: inline-block;
        margin-top: 0.75rem;
        background: #2ea44f;
        color: #060a12;
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.6rem 1.2rem;
        text-decoration: none;
        transition: opacity 0.2s;
      }
      .ct-next-link:hover { opacity: 0.85; }

      .ct-footer {
        position: relative;
        z-index: 1;
        border-top: 1px solid #21262d;
        padding: 1.25rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 860px;
        margin: 0 auto;
      }

      .ct-footer-brand {
        display: flex; align-items: center; gap: 8px;
        font-family: 'Space Mono', monospace;
        font-size: 10px;
        color: #30363d;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .ct-progress {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .ct-pip {
        width: 24px; height: 3px;
        background: #21262d;
      }
      .ct-pip.done { background: #2ea44f; }
      .ct-pip.active { background: #1f6feb; }
    </style>
</head>
<body>

<div class="ct">
  <div class="ct-bg"></div>
  <div class="ct-glow"></div>

  <nav class="ct-nav">
    <a href="#" class="ct-nav-brand">
      <svg class="ct-shield" viewBox="0 0 28 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M14 1L2 6v10c0 7.18 5.14 13.9 12 15.5C20.86 29.9 26 23.18 26 16V6L14 1z" fill="url(#shieldGrad)" opacity="0.15"/>
        <path d="M14 1L2 6v10c0 7.18 5.14 13.9 12 15.5C20.86 29.9 26 23.18 26 16V6L14 1z" stroke="#1f6feb" stroke-width="1.5" fill="none"/>
        <rect x="9" y="9" width="4" height="14" rx="0.5" fill="#58a6ff" opacity="0.9"/>
        <rect x="15" y="9" width="4" height="5" rx="0.5" fill="#58a6ff" opacity="0.9"/>
        <rect x="15" y="18" width="4" height="5" rx="0.5" fill="#58a6ff" opacity="0.9"/>
        <defs>
          <linearGradient id="shieldGrad" x1="14" y1="1" x2="14" y2="31" gradientUnits="userSpaceOnUse">
            <stop stop-color="#58a6ff"/>
            <stop offset="1" stop-color="#1f6feb"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="ct-brand-text">ClayTech</span>
    </a>
    <div class="ct-nav-right">
      <span class="ct-nav-badge">IntroSec CTF</span>
      <span class="ct-nav-pts">Score: <span id="scoreDisplay">0</span> pts</span>
    </div>
  </nav>

  <div class="ct-hero">
    <div class="ct-mission-num">01</div>
    <div class="ct-hero-content">
      <div class="ct-mission-tag">
        <div class="ct-live-dot"></div>
        Mission Active · IntroSec CTF
      </div>
      <h1 class="ct-hero-title">The <span class="ct-blue">Transparent</span> Vault</h1>
      <p class="ct-hero-sub">An administrator built a secure vault login portal — then forgot their password. They left a raw developer note somewhere on the page to help them remember. Can you find it?</p>
      <div class="ct-difficulty-row">
        <span class="ct-badge ct-badge-green">Beginner</span>
        <span class="ct-badge ct-badge-blue">+10 Points</span>
        <span class="ct-badge ct-badge-blue">Client-side Recon</span>
      </div>
    </div>
  </div>

  <div class="ct-main">

    <div class="ct-panel">
      <div class="ct-panel-header">
        <span class="ct-panel-title">Mission Brief</span>
      </div>
      <div class="ct-panel-body">
        <div class="ct-briefing-item">
          <span class="ct-bi-label">Objective</span>
          <span class="ct-bi-val">Locate the hidden developer credential embedded in the vault portal.</span>
        </div>
        <div class="ct-briefing-item">
          <span class="ct-bi-label">Category</span>
          <span class="ct-bi-val">Information Disclosure / Client-side Security</span>
        </div>
        <div class="ct-briefing-item">
          <span class="ct-bi-label">Format</span>
          <span class="ct-bi-val" style="font-family:'Space Mono',monospace; color:#58a6ff;">{flag_text}</span>
        </div>
        <div class="ct-briefing-item">
          <span class="ct-bi-label">Reward</span>
          <span class="ct-bi-val">10 points + Mission 02 unlock</span>
        </div>
        <div class="ct-tip">
          <strong>Hint:</strong> Web browsers let you inspect everything that was sent to your machine. Developers often leave notes in places they think nobody looks.
        </div>
      </div>
    </div>

    <div class="ct-panel">
      <div class="ct-panel-header">
        <span class="ct-panel-title">Admin Secure Login</span>
      </div>
      <div class="ct-panel-body">
        <label class="ct-vault-label">Username</label>
        <input class="ct-vault-input" type="text" value="admin" disabled>

        <label class="ct-vault-label">Password</label>
        <input class="ct-vault-input" type="password" placeholder="••••••••" id="vaultPass">

        <!-- Note to self: The admin password flag is {never_hide_secrets_in_html} -->

        <button class="ct-vault-btn" onclick="vaultAttempt()">Access Vault</button>
        <div class="ct-locked-msg" id="vaultMsg">⚠ SYSTEM LOCKED — Credentials invalid.</div>
      </div>
    </div>

    <div class="ct-panel ct-full">
      <div class="ct-panel-header">
        <span class="ct-panel-title">Flag Submission</span>
      </div>
      <div class="ct-panel-body">
        <div class="ct-flag-wrap">
          <div class="ct-flag-input-row">
            <span class="ct-flag-prefix">$</span>
            <input type="text" id="flagInput" placeholder="{ enter_flag_here }" autocomplete="off" spellcheck="false">
          </div>
          <button class="ct-submit-btn" onclick="submitFlag()">Verify</button>
        </div>
        <div id="result"></div>
      </div>
    </div>

  </div>

  <div class="ct-footer">
    <div class="ct-footer-brand">
      <svg width="14" height="16" viewBox="0 0 28 32" fill="none">
        <path d="M14 1L2 6v10c0 7.18 5.14 13.9 12 15.5C20.86 29.9 26 23.18 26 16V6L14 1z" stroke="#30363d" stroke-width="1.5" fill="none"/>
        <rect x="9" y="9" width="4" height="14" rx="0.5" fill="#30363d"/>
        <rect x="15" y="9" width="4" height="5" rx="0.5" fill="#30363d"/>
        <rect x="15" y="18" width="4" height="5" rx="0.5" fill="#30363d"/>
      </svg>
      ClayTech · IntroSec CTF
    </div>
    <div class="ct-progress">
      <div class="ct-pip active"></div>
      <div class="ct-pip"></div>
      <div class="ct-pip"></div>
      <div class="ct-pip"></div>
      <div class="ct-pip"></div>
    </div>
  </div>
</div>

<script>
  function vaultAttempt() {
    const msg = document.getElementById('vaultMsg');
    msg.style.display = 'block';
    setTimeout(() => msg.style.display = 'none', 3000);
  }

  async function submitFlag() {
    const flag = document.getElementById('flagInput').value.trim();
    const resultDiv = document.getElementById('result');
    const correctFlag = "{never_hide_secrets_in_html}";

    resultDiv.style.display = 'block';

    if (flag === correctFlag) {
      document.getElementById('scoreDisplay').textContent = '10';
      resultDiv.className = 'ct-success';
      resultDiv.innerHTML = `
        ✓ ACCESS GRANTED — Flag verified.<br>
        <span style="color:#8b949e; font-family:'Inter',sans-serif; font-size:12px;">You successfully exploited client-side information disclosure. +10 points awarded.</span><br>
        <a href="#" class="ct-next-link">Proceed to Mission 02 →</a>
      `;
    } else {
      resultDiv.className = 'ct-error';
      resultDiv.innerHTML = `
        ✗ ACCESS DENIED — Invalid flag sequence.<br>
        <span style="color:rgba(248,81,73,0.6); font-family:'Inter',sans-serif; font-size:12px;">Look closer at the page source.</span>
      `;
    }
  }

  document.getElementById('flagInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') submitFlag();
  });
</script>

</body>
</html>
